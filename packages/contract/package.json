{
  "name": "@gotit/contract",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./managed/candor/contract": {
      "types": "./dist/managed/candor/contract/index.d.ts",
      "import": "./dist/managed/candor/contract/index.js"
    },
    "./managed/gotit/contract": {
      "types": "./dist/managed/gotit/contract/index.d.ts",
      "import": "./dist/managed/gotit/contract/index.js"
    },
    "./witnesses": {
      "types": "./dist/witnesses.d.ts",
      "import": "./dist/witnesses.js"
    },
    "./witnesses-v2": {
      "types": "./dist/witnesses.v2.d.ts",
      "import": "./dist/witnesses.v2.js"
    }
  },
  "scripts": {
    "compile": "compact compile src/gotit.compact src/managed/gotit",
    "compile:zk": "compact compile src/gotit.compact src/managed/gotit",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/managed && cp -R src/managed dist/managed",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile:v1": "compact compile src/candor.compact src/managed/candor"
  },
  "dependencies": {
    "@gotit/shared": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
