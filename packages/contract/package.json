{
  "name": "@candor/contract",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./managed/candor/contract": {
      "types": "./dist/managed/candor/contract/index.d.ts",
      "import": "./dist/managed/candor/contract/index.js"
    },
    "./witnesses": {
      "types": "./dist/witnesses.d.ts",
      "import": "./dist/witnesses.js"
    }
  },
  "scripts": {
    "compile": "compact compile src/candor.compact src/managed/candor --skip-zk || compact compile src/candor.compact src/managed/candor",
    "compile:zk": "compact compile src/candor.compact src/managed/candor",
    "build": "tsc -p tsconfig.build.json && cp -R src/managed dist/managed",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@candor/shared": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}