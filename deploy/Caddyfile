{
	auto_https off
}

:8080 {
	handle_path /issuer/* {
		reverse_proxy {$ISSUER_URL} {
			transport http {
				tls
				tls_server_name {$ISSUER_HOST}
			}
		}
	}

	# The indexer GraphQL endpoint. strip_prefix is required (not handle_path)
	# because the path suffix IS the API path: /indexer/api/v4/graphql must reach
	# upstream as /api/v4/graphql. handle_path would additionally strip the
	# trailing slash, which the indexer treats as a different route.
	#
	# WebSocket subscriptions are upgraded transparently by Caddy, so the client
	# can use the same origin for both HTTP queries and ws:// subscriptions.
	handle /indexer/* {
		uri strip_prefix /indexer
		reverse_proxy {$INDEXER_URL} {
			transport http {
				tls
				tls_server_name {$INDEXER_HOST}
			}
		}
	}

	handle_path /proof-server/* {
		reverse_proxy {$PROOF_SERVER_URL} {
			transport http {
				tls
				tls_server_name {$PROOF_SERVER_HOST}
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
