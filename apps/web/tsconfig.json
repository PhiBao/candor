{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@candor/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@candor/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}